      "rag_corpus_path": "a\\..\\b"
    },
    "expected": {
      "rag_corpus_path": ""
    }
  },
  {
    "name": "corpus path keeps an absolute path",
    "input": {
      "rag_corpus_path": "  /home/deck/kb  "
    },
    "expected": {
      "rag_corpus_path": "/home/deck/kb"
    }
  },
  {

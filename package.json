{
  "name": "bonsai",
  "version": "0.5.0",
  "description": "bonsAI Steam Deck plugin: local AI assistance and Ollama integration.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prebuild": "node scripts/sync-version-from-plugin.mjs",
    "build": "rollup -c",
    "prewatch": "node scripts/sync-version-from-plugin.mjs",
    "watch": "rollup -c -w",
    "pretest": "node scripts/sync-version-from-plugin.mjs",
    "test": "vitest run",
    "test:py": "python scripts/run_python_tests.py",
    "test:focus": "node scripts/check-focus-patterns.mjs",
    "test:preview": "node scripts/run-preview-suite.mjs",
    "test:preview:tier": "node scripts/run-preview-suite.mjs --evidence",
    "build:preview": "node scripts/build-preview.mjs",
    "version:sync": "node scripts/sync-version-from-plugin.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "mcp:install": "npm install --prefix packages/bonsai-mcp",
    "mcp:generate": "node packages/bonsai-mcp/scripts/generate-architecture.mjs",
    "mcp:build": "npm run build --prefix packages/bonsai-mcp",
    "mcp:validate": "node packages/bonsai-mcp/scripts/validate-knowledge.mjs --check-generated",
    "mcp:install-hooks": "node scripts/ensure-git-hooks.mjs",
    "prepare": "node scripts/ensure-git-hooks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qd313/bonsAI.git"
  },
  "keywords": [
    "bonsai",
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "ollama",
    "ai"
  ],
  "author": "qwert",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/qd313/bonsAI/issues"
  },
  "homepage": "https://github.com/qd313/bonsAI#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.3",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "decky-frontend-lib": "^3.25.0",
    "rollup": "^4.53.3",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4",
    "jscpd": "5.2.0",
    "knip": "6.35.1",
    "ts-morph": "28.0.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}

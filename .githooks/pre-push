#!/usr/bin/env sh
# Block a push when src/types/rpcMethods.ts no longer matches main.py (the only generated file
# saved in the repo), and when the tool server's knowledge files fail validation.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(dirname "$0")/.."
node packages/bonsai-mcp/scripts/validate-knowledge.mjs --check-generated

# Steam Deck SSH connection (for remote deploy from another PC)
DECK_IP=steamdeck.local
# Same-machine Deck (Cursor on Deck): use loopback so build/screenshot skip SSH-to-self
# DECK_IP=127.0.0.1
# LAN example (override for your network):
# DECK_IP=192.168.86.52
DECK_PORT=22
DECK_USER=deck
DECK_DIR=/home/deck

# Cursor debug NDJSON ingest (Deck plugin posts to 127.0.0.1 on the Deck).
# From your PC run: ./scripts/reverse-tunnel-deck-ingest.ps1 (or .sh) so Deck:7682 forwards here.
# DEBUG_INGEST_PORT=7682

# This machine's IP (for Ollama -- the Deck connects back to this)
PC_IP=192.168.1.100

# Plugin metadata
PLUGIN_NAME=bonsAI

# Where the workshop repo (qd313/bonsAI-workshop) sits on this PC: an absolute folder path.
# Deck check evidence, the saved Deck walks and the eval reports are saved there, not in this repo.
# Order of lookup: this setting in the environment, this line in .env, then the folder named
# bonsAI-workshop next to this repo folder. Leave it unset when the workshop sits next to the repo.
# BONSAI_WORKSHOP=C:/Users/you/Documents/bonsAI-workshop

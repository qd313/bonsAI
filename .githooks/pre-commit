#!/usr/bin/env sh
# Auto-regenerate + stage bonsai-mcp architecture JSON on every commit.
# Enable once per clone: pnpm run mcp:install-hooks
set -e
cd "$(dirname "$0")/.."
node packages/bonsai-mcp/scripts/sync-architecture-for-commit.mjs
python scripts/py_import_graph.py
git add -- packages/bonsai-mcp/knowledge/architecture/py-import-graph.json

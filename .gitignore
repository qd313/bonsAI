decky_plugin.py

# Ignore decky CLI for building plugins
out
out/*
cli/
cli/*
cli/decky

# Local Deck screenshots (scripts/screenshot-deck.sh / screenshot-deck.ps1)
screenshots/*
!screenshots/README.md

# Preview suite run artifacts (JUnit-style JSON reports)
tests/preview-results/

# Local Deck screen recordings (captured by scripts/record-deck.ps1 / record-deck.sh)
recordings/

# v0 UI drafts (reference only; not part of the Decky bundle)
src/v0-drafts/

# Deck walk evidence written by the plugin-studio tools; keep what a testing row cites in docs/test-evidence instead
runs/

# Shared "who is driving the Deck right now" queue (scripts/deck_queue.py) — local coordination state, not plugin content
.decky/deck-queue.json
